{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-webview",
  "description": "Tauri permissions are granted only to the local GAME interface, never to the remote website view.",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-hide",
    "allow-browser-navigate",
    "allow-browser-back",
    "allow-browser-forward",
    "allow-browser-reload",
    "allow-browser-set-bounds",
    "allow-browser-set-visible",
    "allow-recording-event"
  ]
}
